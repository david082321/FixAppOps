<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="local.appops.compat.permission.BROKER" android:protectionLevel="signature" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <queries>
        <package android:name="rikka.appops" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>
    <application
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:description="@string/module_description">
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="local.appops.compat.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <provider
            android:name=".BackendBroker"
            android:authorities="local.appops.compat.bridge"
            android:exported="true"
            android:permission="local.appops.compat.permission.BROKER"
            android:grantUriPermissions="true" />
        <activity android:name=".AccessActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
